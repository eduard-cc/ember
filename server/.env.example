# Nonsecret local API settings. Generate secrets outside tracked source.
GYM_LOG_HOST=127.0.0.1
GYM_LOG_PORT=5190
GYM_LOG_ORIGIN=http://127.0.0.1:5188
GYM_LOG_SESSION_SECURE=false
GYM_LOG_SESSION_TTL_SECONDS=86400
# Password is the compatibility default; explicitly opt in to passwordless Serve:
GYM_LOG_AUTH_MODE=password
# Required only for tailscale mode: exact Tailscale Serve owner login.
# GYM_LOG_TAILSCALE_USER_LOGIN=owner@example.test
# Real tailscale mode also needs an exact https://<host>.<tailnet>.ts.net origin
# and GYM_LOG_SESSION_SECURE=true. Loopback HTTP is for trusted local development.
# Required secrets, intentionally omitted:
# GYM_LOG_DATABASE_URL (development database 127.0.0.1:55439/gym_log_dev; the live
#   trial alone uses gym_log, configured outside the repository)
# GYM_LOG_OWNER_PASSWORD_HASH (required in password mode only; Argon2id encoded hash, never plaintext)
# Compose reads server/.postgres.env containing POSTGRES_USER, POSTGRES_DB,
# POSTGRES_PASSWORD. Both actual env files are ignored; restrict them to mode 0600.
