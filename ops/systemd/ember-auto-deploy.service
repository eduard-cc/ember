# User unit installed by ops/install.sh, started by ember-auto-deploy.timer: deploys
# the head of main once its CI has passed (ops/auto-deploy.sh). The deploy runs in the
# capped jobs slice; ops/deploy.sh restarts ember.service in its own slice.
[Unit]
Description=Ember auto-deploy of main
OnFailure=ember-notify-failure@%n.service

[Service]
Type=oneshot
Slice=ember-jobs.slice
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=%h/src/ember/ops/auto-deploy.sh
TimeoutStartSec=30min
