# User unit installed by ops/install.sh. Ember's own tailnet device (ember), so the
# app has its own HTTPS origin instead of sharing the host's address with other apps.
# Userspace networking: no TUN device or root. Its Serve config proxies HTTPS 443 to the
# app on loopback; inspect it with
#   tailscale --socket="$XDG_RUNTIME_DIR/ember-tailscale/tailscaled.sock" serve status
[Unit]
Description=Ember dedicated private Tailscale device
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=ember-notify-failure@%n.service

[Service]
Type=simple
Slice=ember-live.slice
# UDP 41642, so it never competes with the host's tailscaled on 41641.
ExecStart=/usr/sbin/tailscaled --tun=userspace-networking --port=41642 --socket=%t/ember-tailscale/tailscaled.sock --statedir=%h/.local/share/ember-tailscale
RuntimeDirectory=ember-tailscale
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
RestartMode=direct

[Install]
WantedBy=default.target
