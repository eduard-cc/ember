# User unit installed by ops/install.sh: Gym Log's own rootless Docker daemon. It runs only gym-log-local-postgres; nothing using its socket
# (ops/docker.sh) can see other daemons' containers. The daemon and its containers live in
# gym-log-live.slice, which caps their CPU and memory.
[Unit]
Description=Gym Log rootless Docker daemon
# Five starts within five minutes means it is crash-looping: give up and alert.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=gym-log-notify-failure@%n.service

[Service]
Type=notify
NotifyAccess=all
Slice=gym-log-live.slice
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=builtin
# Not the default state directory, which another rootless daemon of the same user may use.
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_STATE_DIR=%t/gym-log/rootlesskit
ExecStartPre=/usr/bin/mkdir -p %t/gym-log %h/.local/share/gym-log-docker
ExecStartPre=/usr/bin/chmod 700 %t/gym-log %h/.local/share/gym-log-docker
# Raw database files copied mid-write are no backup, and the image can be pulled again:
# the nightly off-device backup skips this tagged folder (it excludes caches) and takes a consistent gym-log.dump through pg_dump instead.
ExecStartPre=/usr/bin/sh -c 'printf "Signature: 8a477f597d28d172789f06886806bc55\\n# Gym Log Docker data: backed up as the nightly gym-log.dump, not as files.\\n" >%h/.local/share/gym-log-docker/CACHEDIR.TAG'
ExecStart=/usr/bin/dockerd-rootless.sh --host=unix://%t/gym-log/docker.sock --data-root=%h/.local/share/gym-log-docker --exec-root=%t/gym-log/exec --pidfile=%t/gym-log/docker.pid --storage-driver=fuse-overlayfs --cgroup-parent=gym-log-live.slice
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Delegate=yes
Restart=on-failure
RestartSec=5s
# Alert once when systemd gives up, not on every automatic restart.
RestartMode=direct
TimeoutStartSec=120s
UMask=0077
LimitNOFILE=1048576
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
