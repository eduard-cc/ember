# User slice installed by ops/install.sh. Holds the live app (ember.service), Ember's
# Docker daemon, its PostgreSQL container and its Tailscale device (ember-tailscale.service),
# so a runaway Ember process cannot starve other services on the host. Hitting the memory cap can stop any of them,
# including the Tailscale device that serves the app's address; systemd restarts it.
# System services sit outside the user manager, whose CPU weights do not reach them, so
# the hard caps are what protect them; the low weight only yields to other user work.
# I/O weights need the io controller, which this host does not delegate to user units.
# Most of the memory in use is reclaimable page cache; the app and database need ~200 MB.
[Unit]
Description=Ember live app and database (capped)

[Slice]
CPUWeight=20
CPUQuota=200%
MemoryHigh=1G
MemoryMax=1536M
MemorySwapMax=512M
TasksMax=1024
