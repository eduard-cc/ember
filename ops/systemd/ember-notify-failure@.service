# User-level equivalent of the root notify-failure@ unit: user units cannot
# trigger system units through OnFailure=.
[Unit]
Description=Send a Hermes Discord message when %i fails

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hermes send --quiet --to discord --subject "[%H]" "%i failed. Details: journalctl --user -u %i -n 50"
