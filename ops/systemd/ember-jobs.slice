# User slice installed by ops/install.sh. ops/limited.sh runs the Ember test suites here
# (browsers, dev servers and test API processes included), so a runaway run cannot starve
# other services on the host. See ember-live.slice for why the caps, not the weight, matter.
[Unit]
Description=Ember test runs (capped)

[Slice]
CPUWeight=20
CPUQuota=400%
MemoryHigh=3500M
MemoryMax=4G
MemorySwapMax=1G
TasksMax=4096
