{
  "name": "@eduard-cc/ember",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite --host 127.0.0.1 --port 5188 --strictPort",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore ../..",
    "format:check": "prettier --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore ../..",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "lint:check": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5188 --strictPort",
    "test:run": "NODE_ENV=test ../../ops/limited.sh vitest run",
    "test:e2e": "../../ops/limited.sh playwright test",
    "test:integration": "../../ops/limited.sh node scripts/integration.mjs",
    "test:pwa": "../../ops/limited.sh playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "4.4.7",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.0.0"
  }
}
