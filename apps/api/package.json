{
	"name": "@eduard-cc/ember-server",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"pretest:e2e": "npm run build",
		"test:e2e": "../../ops/limited.sh node scripts/test-e2e.mjs",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx src/main.ts",
		"start:trial": "node dist/trial.js",
		"migration": "tsx src/migrate.ts",
		"lint": "eslint \"{src,test}/**/*.ts\" --report-unused-disable-directives --max-warnings 0 --fix",
		"lint:check": "eslint \"{src,test}/**/*.ts\" --report-unused-disable-directives --max-warnings 0"
	},
	"dependencies": {
		"@nestjs/common": "11.2.7",
		"@nestjs/core": "11.2.7",
		"@nestjs/platform-express": "11.2.7",
		"argon2": "0.45.2",
		"compression": "1.8.2",
		"dotenv": "17.2.3",
		"pg": "8.23.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"typeorm": "1.1.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/compression": "1.8.1",
		"@types/express": "5.0.6",
		"@types/node": "24.19.2",
		"@types/supertest": "7.2.1",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"supertest": "7.3.1",
		"tsx": "4.23.15",
		"typescript": "5.9.3"
	},
	"overrides": {
		"multer": "^2.5.0"
	}
}
