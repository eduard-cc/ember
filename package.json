{
  "name": "gym-log",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite --host 127.0.0.1 --port 5188 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5188 --strictPort",
    "test:run": "NODE_ENV=test vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/integration.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:recovery": "playwright test --config tests/recovery/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "4.4.6",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "fake-indexeddb": "6.2.5",
    "postcss": "^8.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
